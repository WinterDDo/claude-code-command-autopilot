{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" router \"$HOME/.claude/command-autopilot\"",
            "timeout": 5,
            "statusMessage": "Autopilot routing..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" session-start \"$HOME/.claude/command-autopilot\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" tracker-stop \"$HOME/.claude/command-autopilot\"",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" tracker-skill \"$HOME/.claude/command-autopilot\"",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "matcher": "Agent|Task|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" nudge-subagent \"$HOME/.claude/command-autopilot\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
